# Copie para ".env" e ajuste. NUNCA versione o arquivo .env com segredos reais.

# --- PostgreSQL (usado pelo docker-compose.yml e pela API) ---
POSTGRES_DB=studyhub
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT (a chave deve ter no mínimo 32 caracteres) ---
Jwt__SecretKey=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
Jwt__Issuer=StudyHub
Jwt__Audience=StudyHub.Clients
Jwt__ExpirationMinutes=60

# --- Opcional: sobrescreve a connection string montada a partir das variáveis POSTGRES_* ---
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=studyhub;Username=studyhub;Password=troque_esta_senha

# --- Opcional: aplica migrations automaticamente ao iniciar a API ---
# Database__MigrateOnStartup=true
